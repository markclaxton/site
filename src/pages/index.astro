---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const clients = [
  { name: 'Face the Future', url: 'https://www.facethefuture.co.uk/' },
  { name: 'Spitfire Audio', url: 'https://spitfireaudio.com/' },
  { name: 'Dock & Bay', url: 'https://dockandbay.com/' },
  { name: 'PDH Sports', url: 'https://pdhsports.com/' },
  { name: 'Start Safety', url: 'https://startsafety.uk/' },
  { name: 'Stephen Webster', url: 'https://www.stephenwebster.com/' },
  { name: 'Chilly’s', url: 'https://www.chillys.com/' },
  { name: 'Oceanair', url: 'https://www.oceanairuk.com/' },
  { name: 'Hairburst', url: 'https://www.hairburst.com/' },
  { name: 'Ripon Ground Care', url: 'https://ripongroundcare.com/' },
  { name: 'Admiral Sports', url: 'https://admiralsports.com/' },
  { name: 'Cobra Sport', url: 'https://cobrasport.com/' },
]

// Structured data so search engines understand this is a personal site.
// Add LinkedIn or other profile URLs to sameAs as you like.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mark Claxton',
  url: new URL('/', Astro.site).href,
  image: new URL('/og-image.png', Astro.site).href,
  jobTitle: 'Lead Designer & Developer',
  email: 'mailto:hello@markclaxton.co.uk',
  worksFor: { '@type': 'Organization', name: 'Herd', url: 'https://herd.io' },
  address: { '@type': 'PostalAddress', addressRegion: 'East Yorkshire', addressCountry: 'GB' },
  knowsAbout: ['Shopify', 'Shopify theme development', 'E-commerce', 'Web design', 'Front-end development'],
  sameAs: ['https://github.com/markclaxton'],
}
---

<Layout title="Mark Claxton - Lead Designer & Developer">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </Fragment>
  <Header />
  <main>
    <section>
      <p class="intro">
        Lead designer and developer at <a href="https://herd.io" target="_blank" rel="noopener">Herd<span class="visually-hidden"> (opens in new tab)</span></a>, specialising in building and maintaining custom Shopify themes.
      </p>
      <div class="clients">
        <h2>Some of the clients I’ve worked with:</h2>
        <ul>
          {clients.map(({ name, url }) => (
            <li>
              <a href={url} target="_blank" rel="noopener">{name}<span class="visually-hidden"> (opens in new tab)</span></a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
